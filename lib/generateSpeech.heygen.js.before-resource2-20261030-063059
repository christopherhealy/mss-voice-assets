// Single Italian Host-line adapter. No credential lookup or live transport is installed.
import {createHash} from 'node:crypto';
import {lookup} from 'node:dns/promises';
import {isIP} from 'node:net';
export const HOST_TEXT='Ciao! Sono Julie. Benvenuto a Firenze! Preferisci soggiornare in centro oppure in campagna?';
export const TIZIANA_ID='ebbc053d046742c582f273f1334c58d8';
const digest=text=>createHash('sha256').update(text).digest('hex');
const unavailable=()=>Error('heygen_audio_unavailable_no_regeneration');
const limit=20*1024*1024;
async function bounded(response,max) {
  if(Number(response.headers.get('content-length'))>max)throw unavailable();
  const reader=response.body?.getReader();
  if(!reader)throw unavailable();
  const parts=[];let length=0;
  try {for(;;){const {done,value}=await reader.read();if(done)break;
    length+=value.byteLength;if(length>max)throw unavailable();parts.push(Buffer.from(value));}}
  finally {await reader.cancel().catch(()=>{});}
  return Buffer.concat(parts);
}
function configuration(text,profile,validateText) {
  if(typeof validateText!=='function'||validateText(text,profile)!==true||profile?.voiceId!==TIZIANA_ID||profile.provider!=='heygen'||profile.language!=='it'||
    profile.actor!=='julie'||profile.voice!=='tiziana'||profile.engine!=='elevenlabs'||profile.model!=='eleven_multilingual_v2'||
    profile.approved!==true||profile.settings?.speed!==1||Object.keys(profile.settings).some(k=>k!=='speed'))throw unavailable();
}
// HTTPS destinations are exact operator-reviewed hostnames; no wildcard or inferred CDN trust.
export function createHeygenSpeech({request,credential,allowedAudioHosts=['files.heygen.ai'],
  resolve=host=>lookup(host,{all:true}),now=Date.now,validateText=(text)=>text===HOST_TEXT}={}) {
  const hosts=new Set(allowedAudioHosts);
  async function audioUrl(value) {
    const url=new URL(value);
    if(url.protocol!=='https:'||url.username||url.password||url.hash||url.port&&url.port!=='443'||
      !hosts.has(url.hostname)||isIP(url.hostname)||url.hostname==='localhost')throw unavailable();
    const addresses=await resolve(url.hostname);
    // Fail closed on private/reserved IPv4, IPv6, or an empty DNS result. IPv6 can be reviewed later.
    if(!addresses.length||addresses.some(({address})=>{
      if(isIP(address)!==4)return true;
      const [a,b]=address.split('.').map(Number);
      return a===0||a===10||a===127||a>=224||a===169&&b===254||a===172&&b>=16&&b<=31||a===192&&b===168||a===100&&b>=64&&b<=127||a===198&&(b===18||b===19);
    }))throw unavailable();
    return url;
  }
  async function recover({text,profile,recovery}) {
    try {
      configuration(text,profile,validateText);
      if(typeof request!=='function'||recovery?.version!==1||recovery.voiceId!==TIZIANA_ID||
        recovery.textHash!==digest(text)||recovery.engine!=='elevenlabs'||recovery.requestedModel!==profile.model||
        !recovery.requestId||!Number.isFinite(recovery.duration)||recovery.duration<=0||recovery.duration>60)throw unavailable();
      let url=await audioUrl(recovery.audioUrl);
      for(let hop=0;hop<=3;hop++) {
        const response=await request(url.href,{method:'GET',headers:{Accept:'audio/mpeg'},
          redirect:'manual',credentials:'omit',signal:AbortSignal.timeout(30000)});
        if([301,302,303,307,308].includes(response.status)) {
          const location=response.headers.get('location');await response.body?.cancel();
          if(hop===3||!location)throw unavailable();
          url=await audioUrl(new URL(location,url).href);continue;
        }
        if(response.status!==200) {await response.body?.cancel();throw unavailable();}
        const mime=(response.headers.get('content-type')||'').split(';')[0].trim().toLowerCase();
        if(!['audio/mpeg','audio/mp3','application/octet-stream'].includes(mime)) {await response.body?.cancel();throw unavailable();}
        const buffer=await bounded(response,limit);
        if(!(buffer.subarray(0,3).toString()==='ID3'||buffer.length>1&&buffer[0]===255&&(buffer[1]&224)===224))throw unavailable();
        return {buffer,mimeType:'audio/mpeg',generationProvider:'heygen',generationModel:profile.model,
          providerRequestId:recovery.requestId,durationSeconds:recovery.duration,durationMs:Math.round(recovery.duration*1000),generationMs:recovery.generationMs,
          characterCount:text.length,providerResponseJson:{request_id:recovery.requestId,engine:recovery.engine,
            requested_model:recovery.requestedModel,duration:recovery.duration}};
      }
      throw unavailable();
    }catch{throw unavailable();}
  }
  async function generate({text,profile,persistRecovery}) {
    try {
      configuration(text,profile,validateText);
      if(typeof request!=='function'||typeof credential!=='function'||typeof persistRecovery!=='function')throw unavailable();
      const key=await credential();
      if(typeof key!=='string'||!key||/[\r\n\0]/.test(key))throw unavailable();
      const started=now();
      // Exactly one POST. No SDK retry, redirect following, or regeneration on failure.
      const response=await request('https://api.heygen.com/v3/voices/speech',{method:'POST',
        headers:{'X-Api-Key':key,'Content-Type':'application/json',Accept:'application/json'},
        body:JSON.stringify({text,voice_id:TIZIANA_ID,engine:'elevenlabs',language:'it',input_type:'text',
          speed:1,force_regenerate:false,settings:{model_id:'eleven_multilingual_v2'}}),
        redirect:'manual',credentials:'omit',signal:AbortSignal.timeout(90000)});
      if(response.status!==200){await response.body?.cancel();throw unavailable();}
      const payload=JSON.parse((await bounded(response,1024*1024)).toString('utf8')),data=payload?.data;
      if(typeof data?.audio_url!=='string'||data.audio_url.length>16384||typeof data.request_id!=='string'||
        !data.request_id||data.request_id.length>256||typeof data.engine!=='string'||
        !Number.isFinite(data.duration))throw unavailable();
      const recovery={version:1,voiceId:TIZIANA_ID,textHash:digest(text),audioUrl:data.audio_url,
        requestId:data.request_id,duration:data.duration,engine:data.engine,requestedModel:profile.model,
        generationMs:now()-started};
      // Must be an awaited, protected durable write BEFORE any audio GET. URL is a bearer capability.
      await persistRecovery(recovery);
      return await recover({text,profile,recovery});
    }catch{throw unavailable();}
  }
  generate.recover=recover;
  return generate;
}
